# ============================================================
#  Agent Zero To One · 环境变量模板
# ------------------------------------------------------------
#  使用方法：
#    1. 把本文件复制为 code/.env
#    2. 填入你的 API Key
#    3. 运行 python ch01_first_call.py
#
#  ⚠️ .env 不要提交到 Git！本项目 .gitignore 已默认忽略它。
# ============================================================

# ---------- 必填：你的 API Key ----------
OPENAI_API_KEY=

# ---------- 必填：服务商的接口地址 ----------
# 注意：几乎所有服务商都要求以 /v1 结尾，漏了会报 404
# 常见取值（任选其一）：
#   DeepSeek     https://api.deepseek.com/v1
#   通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4
#   月之暗面 Kimi https://api.moonshot.cn/v1
#   硅基流动      https://api.siliconflow.cn/v1
#   OpenAI       https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ---------- 必填：模型名 ----------
# 必须和服务商匹配，写错会报 404 model not found
#   DeepSeek     deepseek-chat
#   通义千问      qwen-plus
#   智谱 GLM     glm-4-flash
#   月之暗面      moonshot-v1-8k
#   OpenAI       gpt-4o-mini
OPENAI_MODEL=deepseek-chat

# ---------- 可选：离线 Mock 模式开关 ----------
# 设为 1 时，完全不联网，用内置的规则模拟模型响应。
# 用途：调试代码逻辑、验证自己的理解、在没 Key 的机器上学习。
# 留空或设为 0 时：如果上面配了 OPENAI_API_KEY 就走在线模式。
AGENT_MOCK=

# ---------- 可选：生成参数默认值 ----------
# 不填则用代码里的默认值
# AGENT_TEMPERATURE=0.7
# AGENT_MAX_TOKENS=2048
# AGENT_TIMEOUT=60

# ---------- 可选：成本控制（第 13 章用） ----------
# 单次任务允许消耗的最大金额（人民币元），超过则中止
# AGENT_BUDGET_CNY=0.5
